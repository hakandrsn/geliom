{
  "expo": {
    "name": "Geliom",
    "slug": "geliom",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "geliom",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/ios-light.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "bundleIdentifier": "com.eoist.geliom",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.eoist.geliom.onesignal"
        ]
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Geliom konumunuzu kullanmaz. Bu izin yalnızca ağ bağlantı durumunu kontrol eden sistem bileşenleri için gereklidir."
      },
      "appleTeamId": "NHKQ38KYTV"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/android-monochrome.png",
        "backgroundColor": "#0F203E"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.eoist.geliom"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "@react-native-google-signin/google-signin"
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "iPhoneDeploymentTarget": "16.4"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "enableSceneSupport": true,
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Figtree-Light.ttf",
            "./assets/fonts/Figtree-Regular.ttf",
            "./assets/fonts/Figtree-Medium.ttf",
            "./assets/fonts/Figtree-SemiBold.ttf",
            "./assets/fonts/Figtree-Bold.ttf"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D9622B"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "geliom",
          "organization": "eoist"
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "react-native-adapty"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "apiBaseUrl": "https://geliom-api.tecktick.com",
      "oneSignalAppId": "c3a9e24a-d8ef-42cb-8278-f171d2056a4d",
      "adaptySdkKey": "public_live_J0dGY5Fb.5J2JuJpyBtyu3wF91JU2",
      "eas": {
        "projectId": "f2d7bad9-aa20-473b-ba30-acbdf499245c"
      }
    },
    "owner": "eoist",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f2d7bad9-aa20-473b-ba30-acbdf499245c"
    }
  }
}
